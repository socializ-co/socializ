NODE_ENV=development
PORT=3001

# Auth deployment edition: CE (Community), EE (Enterprise), CL (Cloud)
SOCIALIZ_EDITION=CE

# PostgreSQL used by Better Auth for users, sessions and organizations.
DATABASE_URL=postgres://socializ:socializ@localhost:5432/socializ

# Better Auth runtime settings.
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Required only for SOCIALIZ_EDITION=EE.
# SOCIALIZ_LICENSE_KEY is an RS256 JWT issued by Socializ.
# SOCIALIZ_LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----
# SOCIALIZ_LICENSE_KEY=eyJ...

# Required only for SOCIALIZ_EDITION=CL.
SOCIALIZ_CLOUD_PLAN=starter

# API
NODE_ENV=development
PORT=3001

# API auth deployment policy: CE (Community), EE (Enterprise), CL (Cloud)
SOCIALIZ_EDITION=CE
DATABASE_URL=postgres://socializ:socializ@localhost:5432/socializ
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Required for EE only.
# SOCIALIZ_LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----
# SOCIALIZ_LICENSE_KEY=eyJ...

# Required for CL only: starter | pro | enterprise
# SOCIALIZ_CLOUD_PLAN=starter

# Client distribution: CE (Community) | EE (Enterprise) | CL (Cloud)
NEXT_PUBLIC_EDITION=CE
NEXT_PUBLIC_API_URL=http://localhost:3001

# Add local service credentials here when integrations are introduced.
# Never commit real credentials. Keep this file limited to variable names and safe defaults.
